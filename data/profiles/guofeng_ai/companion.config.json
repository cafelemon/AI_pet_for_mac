{
  "window": {
    "alwaysOnTop": true,
    "transparent": true,
    "draggable": true
  },
  "renderer": {
    "defaultState": "idle",
    "assetRoot": "assets",
    "keyframeRoot": "keyframes",
    "webmRoot": "webm",
    "keyframeCanvas": {
      "width": 1536,
      "height": 1728
    },
    "defaultScale": 1,
    "minScale": 0.75,
    "maxScale": 1.25,
    "scaleStep": 0.1
  }
}
